# Supabase – utilisé par l'app Next.js pour afficher les pages (bucket public)
# Ces variables NEXT_PUBLIC_* sont exposées au client : n'y mets jamais de clé secrète.
# À configurer aussi dans Vercel (Project Settings > Environment Variables).

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Même nom de bucket que dans scraper/.env
NEXT_PUBLIC_SUPABASE_BUCKET=comics
