# Supabase – utilisé par le scraper pour uploader les pages (LOCAL UNIQUEMENT)
# Ne jamais committer le vrai .env ni mettre ces clés sur Vercel.

# Project Settings > API > Project URL
SUPABASE_URL=https://xxxx.supabase.co
# Project Settings > API > service_role (SECRET — reste en local)
SUPABASE_SERVICE_KEY=
# Nom du bucket Storage (doit être public)
SUPABASE_BUCKET=comics
# Mettre false si ton réseau/antivirus resigne les certificats (erreur SSL self-signed)
SCRAPER_VERIFY_SSL=true
